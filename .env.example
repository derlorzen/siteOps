HOST=0.0.0.0
PUBLIC_BASE_URL=https://siteops.lorzen.cloud

# Hostinger MySQL. DB_HOST is normally localhost when the database belongs to the same hosting plan.
DB_HOST=localhost
DB_PORT=3306
DB_USER=CHANGE_ME
DB_PASSWORD=CHANGE_ME
DB_NAME=CHANGE_ME
# Alternative supported form:
# DATABASE_URL=mysql://USER:PASSWORD@localhost:3306/DATABASE

SITEOPS_MASTER_KEY=BASE64_32_BYTE_KEY
MCP_API_TOKEN=CHANGE_ME_LONG_RANDOM_TOKEN
DASHBOARD_USER=kai
DASHBOARD_PASSWORD=CHANGE_ME_LONG_PASSWORD

# Private repository used only for customer-site snapshots.
GITHUB_BACKUP_REPO=derlorzen/lorzen-site-backups
GITHUB_BACKUP_TOKEN=github_pat_CHANGE_ME
BACKUP_REPO_BRANCH=main
BACKUP_MAX_FILE_BYTES=52428800

# Defaults for newly added websites. These can also be changed later in the SiteOps UI.
DEFAULT_BACKUP_INTERVAL_SECONDS=86400
DEFAULT_BACKUP_MAX_FILES=10000
DEFAULT_MONITOR_INTERVAL_SECONDS=60
DEFAULT_MONITOR_FAILURE_THRESHOLD=3
DEFAULT_SSL_WARN_DAYS=14

ALERT_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=SiteOps <siteops@lorzen.de>
ALERT_WEBHOOK_URL=
MONITOR_WORKER_INTERVAL_MS=30000
BACKUP_WORKER_INTERVAL_MS=60000

# SEO crawler. PageSpeed key is optional; the normal crawl works without it.
SEO_MAX_PAGES=100
SEO_LINK_CHECK_LIMIT=1000
SEO_EXTERNAL_LINK_CHECK_LIMIT=300
SEO_WORKER_INTERVAL_MS=300000
SEO_REGRESSION_ALERT_DROP=10
PAGESPEED_API_KEY=
SEO_USER_AGENT=Lorzen-SiteOps-SEO/0.9
