{
  "name": "lorzen-siteops",
  "version": "1.1.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node app.mjs",
    "migrate": "node app.mjs --migrate",
    "check": "node --check app.mjs",
    "check:runtime": "node app.mjs --check-runtime",
    "lint": "eslint app.mjs lib migrations test",
    "format": "prettier --write app.mjs lib migrations test",
    "format:check": "prettier --check app.mjs lib migrations test",
    "test": "node --test"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.2.2",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "basic-ftp": "^6.2.1",
    "fastify": "^5.12.5",
    "nodemailer": "^10.0.10",
    "ssh2-sftp-client": "^12.1.1",
    "zod": "^4.1.11",
    "php-parser": "^3.7.0",
    "mysql2": "^3.15.0",
    "cheerio": "^1.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "prettier": "^3.6.2"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/derlorzen/siteOps.git"
  }
}
