[Unit]
Description=SiteOps Chromium Browser Runner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=siteops-runner
Group=siteops-runner
WorkingDirectory=/opt/siteops-browser-runner
EnvironmentFile=/etc/siteops-browser-runner.env
Environment=PLAYWRIGHT_BROWSERS_PATH=0
ExecStart=/usr/bin/env node /opt/siteops-browser-runner/server.mjs
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
KillSignal=SIGINT

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/siteops-browser-runner
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
