# Copy to docker-compose.yml, fill in BROWSER_RUNNER_TOKEN (openssl rand -base64 32),
# then: docker compose up -d
#
# Binds to 127.0.0.1 only - put your own reverse proxy (Nginx, Caddy, Traefik, ...)
# in front for HTTPS, then enter that public URL + token in
# SiteOps -> Einstellungen -> Synthetic Runner.

services:
  siteops-browser-runner:
    build: .
    restart: unless-stopped
    environment:
      BROWSER_RUNNER_TOKEN: 'replace-with-a-long-random-token'
      VIDEO_OUTPUT_DIR: /data/video-studio
      VIDEO_MODEL_DIR: /data/video-studio/models
      # Optional: OpenAI is only used when a project explicitly selects OpenAI.
      # OPENAI_API_KEY: 'set-through-your-secret-manager'
      # Fallback only until explicitly overridden in SiteOps > Video Studio.
      # VIDEO_ALLOWED_HOSTS: '*.lorzen.de,shop.lorzen.link'
    volumes:
      - siteops-video-data:/data/video-studio
    ports:
      - '127.0.0.1:3200:3200'

volumes:
  siteops-video-data:
